#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

export TERM=linux

echo ""
echo "=== zaurus-refresh initramfs, corgi kernel ==="
echo ""

if [ -x /bin/zsh ] && /bin/zsh -c 'exit 0' 2>/dev/null; then
	exec /bin/zsh -l
fi

echo "zsh unavailable or failed a smoke test, falling back to ash" >&2
exec /bin/ash -l
