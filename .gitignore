# =====================================================================
#  zaurus-refresh .gitignore
#
#  Philosophy: track hand-written SOURCE (patched kernel .c files, board
#  configs, rootfs config/scripts, flash tooling sources, docs) and the
#  small tracked kernel blobs (zImage-*). Never track large build outputs,
#  device dumps, upstream source trees, or copied-in binaries -- they are
#  all regenerated from the tracked sources + documented build steps.
# =====================================================================

# --- Large upstream/build trees (rebuilt from configs + patch files) ---
kernel-src/
qemu-spitz/
# Emulator SD root built by tools/build-emulator-image.sh, and the QEMU-only
# kernel variant tools/build-and-emulate.sh builds. Both are large and fully
# regenerable; the *sources* that matter live in tools/qemu-corgi/.
*-emulator-sd.img
.emulator-sd.img
zImage-qemu-testing

# =====================================================================
#  initramfs/  -- busybox source + built cpio images. Tracked
#  source-of-truth lives in modules/initramfs/ (busybox.config, init) +
#  tools/build-initramfs.sh; everything under initramfs/ itself is
#  regenerated by that script and stays gitignored, same philosophy as
#  kernel-src/.
# =====================================================================
initramfs/busybox-1.36.1/
initramfs/busybox-1.36.1.tar.bz2
initramfs/*.cpio.gz
# out-of-tree busybox build dir(s) created by tools/build-initramfs.sh
initramfs/.build-*/
# assembled rootfs trees (built or hand-built reference copies) -- none
# of these are source-of-truth, all regenerable from modules/initramfs/
initramfs/rootfs-minimal/
initramfs/rootfs-build/
initramfs/rootfs/

# --- Editor / tool caches ---
.cache/
**/.cache/
.vscode/
# Claude Code local session state -- settings.local.json is per-machine,
# and worktrees/ holds full agent-task checkouts (can be hundreds of MB).
.claude/

# =====================================================================
#  flash/  -- track *.c / *.sh / *.py / *.md tooling + the small tracked
#  bootstrap zImage; ignore built NAND images, device backups, recovery
#  blobs, checksums, and compiled helper binaries (their sources ARE kept).
#  flash/mtd3.jffs2 is the exception: it's the only place a full "home"
#  userland (busybox, /bin, /lib, device nodes) exists anywhere for this
#  project -- build-mtd3-jffs2.sh only builds INCREMENTALLY onto an
#  existing image, it has no from-scratch path. Tracked via Git LFS
#  (see .gitattributes) so CI and fresh clones have a real base to work
#  from instead of silently having no way to produce mtd3.jffs2 at all.
# =====================================================================
flash/*.ko
flash/modules/
flash/.cache/
flash/*.cpio.gz
flash/*.jffs2.*
flash/*.bin
flash/*.img
flash/*.sha256
flash/*.enc
flash/recovery-dbks/
# generated by tools/encode-updater.py from flash/updater-uncoded.sh --
# a ciphered build output, not a tracked source
flash/updater-encoded.sh
# built kernel images are build artifacts, not tracked
flash/zImage
flash/zImage-*
flash/zImage.*
# compiled flash helpers -- the matching *.c sources are tracked
flash/piko-smf-write
flash/piko-backup
# tools/build-piko-install.sh's actual output location (flat in flash/,
# matching where piko.cfg/updater.sh expect it on the SD card) -- distinct
# from flash/src/piko-install below, which is a different build path
flash/piko-install
# compiled outputs for flash/src/ -- sources are tracked, binaries go to flash/bin/
flash/src/*.o
flash/src/piko-install
# flash/bin/ holds compiled binaries; only .gitkeep is tracked
flash/bin/*
!flash/bin/.gitkeep

# =====================================================================
#  tools/  -- track *.py / *.sh tooling + tools/src/*.c sources; ignore
#  compiled binaries built from tools/src/.
# =====================================================================
tools/src/*.o
tools/src/encsh

# =====================================================================
#  rootfs/  -- the staged stage-2 rootfs (formerly nand-root/). Track
#  hand-written config and scripts only; the large copied-in artifacts
#  (kernel modules, the full zImage, busybox/coreutils, zsh functions,
#  terminfo) are rebuilt.
# =====================================================================
rootfs/lib/
rootfs/boot/
rootfs/bin/
rootfs/sbin/
rootfs/usr/bin/
# Contents rather than the directory itself: git never descends into an
# excluded directory, so "rootfs/usr/share/" would make the negation below
# impossible to express.
rootfs/usr/share/*
# ...the exception being the boot splash asset. It is not a copied-in
# artifact rebuilt from something else on the machine -- it is generated art
# (tools/make-splash.py, from modules/initramfs/splash-src.png) and this is
# the only copy. flash/build-update-package.sh ships rootfs/ by walking the
# disk, so leaving it untracked would work locally and silently produce a
# splash-less package in CI or from a fresh clone.
!rootfs/usr/share/piko/
rootfs/home/
# Not a bare "rootfs/root/" (trailing-slash directory excludes block git
# from ever descending into the directory at all, so a child can never be
# re-included by a later negation, no matter how it's written -- a
# documented gitignore limitation). "/*" excludes contents individually
# instead, which DOES allow the specific re-include below.
rootfs/root/*
# .matchbox/wallpaper is hand-written config (the default wallpaper CHOICE
# piko-sync-deploy seeds -- see manifest.yaml's core_scripts section), not a
# copied-in build artifact like the rest of rootfs/root/ -- same
# re-include pattern as flash/bin/.gitkeep below.
!rootfs/root/.matchbox/
rootfs/root/.matchbox/*
!rootfs/root/.matchbox/wallpaper
# usr/sbin is a mix of hand-written scripts and copied-in ELF binaries:
# ignore everything, then re-include the scripts that ARE source-of-truth.
rootfs/usr/sbin/*
!rootfs/usr/sbin/audioon
!rootfs/usr/sbin/audinfo
!rootfs/usr/sbin/softreboot
!rootfs/usr/sbin/sdcard
!rootfs/usr/sbin/fbrun
!rootfs/usr/sbin/fbtext
!rootfs/usr/sbin/wifiup
!rootfs/usr/sbin/netinfo
!rootfs/usr/sbin/ver
!rootfs/usr/sbin/cardinfo
!rootfs/usr/sbin/sdapps
!rootfs/usr/sbin/bright
!rootfs/usr/sbin/flip
!rootfs/usr/sbin/settime
!rootfs/usr/sbin/smfcommit
!rootfs/usr/sbin/pkgadd
!rootfs/usr/sbin/pkgdel
!rootfs/usr/sbin/pkglist
!rootfs/usr/sbin/deskscan
!rootfs/usr/sbin/suspend
!rootfs/usr/sbin/gototty

# =====================================================================
#  userspace/  -- upstream source trees + tarballs + compiled test bins;
#  our own small sources under userspace/src/*.c are tracked.
# =====================================================================
userspace/*.tar.gz
userspace/*.tar.bz2
userspace/*.tar.xz
userspace/src/*.tar.gz
userspace/src/*.tar.bz2
userspace/src/*.tar.xz
userspace/pcmciautils-018/
userspace/sysfsutils-2.1.0/
userspace/wpa_supplicant-2.11/
userspace/wireless_tools.29/
userspace/bin/
# upstream source trees vendored under userspace/src/
# dropbear + openssh: fetched, sha256-verified and built by
# tools/build-ssh.sh (scp + sftp-server + a reproducible dropbear); the
# version-globbed patterns mean bumping DROPBEAR_VERSION/OPENSSH_VERSION in
# that script does not also need a .gitignore edit.
userspace/src/dropbear-*/
userspace/src/openssh-*/
userspace/src/kexec-tools-2.0.30/
userspace/src/mtd-utils-2.2.0/
userspace/src/microwindows/
userspace/src/wireless_tools.29/
userspace/src/wpa_supplicant-2.10/
userspace/src/statusbar/
userspace/src/alsa-lib-*/
userspace/src/alsa-utils-*/
# tools/build-alsa.sh output: full dev install (headers/.la/.pc) and the
# pruned runtime-only payload meant to be copied to the device -- both
# regenerated from tools/build-alsa.sh, not source.
userspace/stage-alsa/
userspace/stage-alsa-runtime/
# tools/build-ssh.sh output: the device payload (scp, sftp-server,
# dbclient, dropbearkey, dropbear), already usr/... rooted.
userspace/stage-ssh/
# tools/build-mplayer.sh: vendored MPlayer-1.5 release tarball + source tree
# (bundles its own ffmpeg/ snapshot -- ~130MB extracted), and its staged
# device payload (a single statically-linked mplayer binary).
userspace/src/MPlayer-*/
userspace/stage-mplayer/
# tools/build-sdl.sh: vendored SDL-1.2.15 release tarball + source tree,
# and its staged dev install / device-payload runtime tree (shared
# libSDL-1.2.so.0 + the sdltest smoke-test binary).
userspace/src/SDL-*/
userspace/stage-sdl/
userspace/stage-sdl-runtime/
# X11 cross-build staging trees: stage-target is the ARM sysroot every X
# package is configured/installed against (~58MB of headers, .so, .pc);
# stage-host holds the host-side helpers an earlier bring-up session used.
# Both are regenerated by rebuilding the userspace/src/ X submodules, and
# the hand-written source that IS tracked lives in userspace/xkb/.
userspace/stage-target/
userspace/stage-host/
# compiled host tools (built from the tracked .c next to them)
userspace/src/md5sum
# brightd is an ARM target binary, not a host tool, but same rule: the
# tracked source is brightd.c and tools/build-userspace.sh rebuilds it.
userspace/src/brightd
# flipd likewise -- tracked source is flipd.c, same build step.
userspace/src/flipd
userspace/src/kill
# clock tools, same rule -- tracked source is hwclock.c / ntpsync.c and
# tools/build-userspace.sh rebuilds both.
userspace/src/hwclock
userspace/src/ntpsync
# mhz: same rule again -- tracked source is mhz.c, tools/build-userspace.sh
# rebuilds it.
userspace/src/mhz
# cardswap: same rule -- tracked source is cardswap.c, rebuilt by
# tools/build-userspace.sh and shipped by tools/chunked-deploy.sh.
userspace/src/cardswap
# piko-splash: same rule -- tracked source is piko-splash.c, rebuilt by
# tools/build-userspace.sh. NB the *asset* it draws
# (rootfs/usr/share/piko/splash.raw) IS tracked: it is generated art, not a
# build product, and the rootfs/ overlay ships verbatim.
userspace/src/piko-splash
# toasters is an ARM target binary too, same rule -- tracked source is
# toasters.c, tools/build-toasters.sh (via tools/build-userspace.sh) rebuilds it.
userspace/src/toasters
# xsha1-compat: sha1.c/sha1.h are tracked source, libmd.* + sha1.o are
# build output from compiling them
userspace/src/xsha1-compat/*.o
userspace/src/xsha1-compat/libmd.*

# --- misc vendored patch trees ---
modules/nand/hostap-patched/

# Kernel build output blobs are tracked directly as zImage-* (small enough).

toolchain/
# tools/build-thirdparty-deps.sh download cache (upstream tarballs,
# re-fetched and sha256-verified on demand)
userspace/.thirdparty-cache/
# qemu-user core dumps from smoke-testing cross-built binaries on the host
# (mb-applet-system-monitor and mb-applet-battery segfault with no display
# -- they use mb_tray_app_new()'s result without a NULL check, unlike
# clock/launcher; see docs/HOWTO-MATCHBOX-DESKTOP.md)
*.core

# tools/build-piko-sync.sh's default --out is the repo root
/*.ipk
