#!/bin/sh
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null

if test -c /dev/tty0; then
	exec > /dev/tty0 2>&1
fi

say() {
	echo "$*"
	echo "$*" > /dev/ttyS0 2>/dev/null
}

run() {
	say "+ $*"
	"$@" 2>&1
	rc=$?
	test $rc -eq 0 || say "  rc=$rc"
	return $rc
}

rescue() {
	say ""
	say "=== bootstrap stopped: $* ==="
	say "=== dropping to a shell, the board stays up ==="
	say ""
	while true; do
		setsid cttyhack /bin/ash -l
		sleep 1
	done
}

export TERM=linux
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root

FLAVOR=nand
test -f /piko-flavor && FLAVOR=$(cat /piko-flavor)

say ""
say "=== zaurus-refresh bootstrap ($FLAVOR) ==="
say "kernel: $(uname -r)"
say "cmdline: $(cat /proc/cmdline 2>/dev/null)"

for bl in /sys/class/backlight/*/; do
	if test -f "$bl/max_brightness"; then
		cat "$bl/max_brightness" > "$bl/brightness" 2>/dev/null
		echo 0 > "$bl/bl_power" 2>/dev/null
		say "backlight: $bl -> $(cat "$bl/brightness" 2>/dev/null)"
	fi
done

/bin/fbsplash -s /splash.ppm 2>/tmp/fbsplash.err
say "fbsplash rc=$? $(cat /tmp/fbsplash.err 2>/dev/null)"

case "$FLAVOR" in
nand)
	MEDIUM="NAND"
	DEVICES="/dev/mtdblock2"
	FSTYPE=jffs2
	PAYLOAD_DIR=boot
	;;
sd)
	MEDIUM="SD"
	DEVICES="/dev/mmcblk0p1 /dev/mmcblk0"
	FSTYPE=vfat
	PAYLOAD_DIR=.zaurus
	;;
cf)
	MEDIUM="CF"
	DEVICES="/dev/sda1 /dev/sda /dev/hda1 /dev/hda"
	FSTYPE=vfat
	PAYLOAD_DIR=.zaurus
	;;
*)
	rescue "unknown flavor '$FLAVOR'"
	;;
esac

say "looking for $MEDIUM ($FSTYPE) on: $DEVICES"
mkdir -p /mnt/boot

BOOTDEV=
tries=0
while test $tries -lt 30; do
	for d in $DEVICES; do
		test -b "$d" || continue
		say "trying $d"
		if mount -t "$FSTYPE" "$d" /mnt/boot 2>&1; then
			BOOTDEV="$d"
			break
		fi
	done
	test -n "$BOOTDEV" && break
	tries=$((tries + 1))
	test $tries = 1 && say "no device yet, waiting up to 30s"
	sleep 1
done

if test -z "$BOOTDEV"; then
	say "block devices present:"
	say "$(ls -l /dev/mmcblk* /dev/sd* /dev/hd* /dev/mtdblock* 2>/dev/null)"
	say "partitions:"
	say "$(cat /proc/partitions 2>/dev/null)"
	rescue "nothing mountable on $MEDIUM"
fi

say "mounted $BOOTDEV on /mnt/boot"
say "$(ls -l /mnt/boot/$PAYLOAD_DIR 2>&1)"

KERNEL=/mnt/boot/$PAYLOAD_DIR/zImage-full
ROOTIMG=$PAYLOAD_DIR/piko-root.img
APPEND="console=ttyS0,115200 console=tty0 loglevel=8"

BOOTCFG=/mnt/boot/$PAYLOAD_DIR/piko-boot.cfg
if test -f "$BOOTCFG"; then
	say "reading $PAYLOAD_DIR/piko-boot.cfg"
	while read -r key value; do
		case "$key" in
		kernel) KERNEL=/mnt/boot/$value ;;
		root)   ROOTIMG=$value ;;
		append) APPEND=$value ;;
		esac
	done < "$BOOTCFG"
fi

test -f "$KERNEL" || rescue "no $PAYLOAD_DIR/zImage-full on $BOOTDEV"

if test "$FLAVOR" = nand; then
	PIKOROOT="mtd:$BOOTDEV"
else
	test -f "/mnt/boot/$ROOTIMG" || rescue "no $ROOTIMG on $BOOTDEV"
	PIKOROOT="img:$BOOTDEV:$ROOTIMG"
fi

KEXEC=/mnt/boot/$PAYLOAD_DIR/kexec
test -x "$KEXEC" || KEXEC=/mnt/boot/sbin/kexec
test -x "$KEXEC" || rescue "no kexec binary at $PAYLOAD_DIR/kexec or /sbin/kexec"

say "kernel:  $KERNEL ($(wc -c < "$KERNEL" 2>/dev/null) bytes)"
say "pikoroot: $PIKOROOT"
say "kexec:   $KEXEC"

run "$KEXEC" -d -l "$KERNEL" --atags --append="$APPEND pikoroot=$PIKOROOT" \
	|| rescue "kexec -l failed"

say "kexec -l ok, syncing and jumping to stage 2"
sync

"$KEXEC" -e 2>&1
rescue "kexec -e returned instead of booting stage 2"
