+/*
+ * PATCHED (zaurus-refresh): absolute-pointer (touchscreen) support.
+ *
+ * Stock kdrive evdev only ever drives a *relative* pointer: EvdevPtrMotion()
+ * enqueues nothing for EV_ABS (it just ErrorF()s the values as debug), and
+ * EvdevPtrBtn() ignores BTN_TOUCH entirely because 0x14a falls outside its
+ * BTN_MOUSE..BTN_JOYSTICK (0x110..0x11f) range. So an ads7846 touchscreen
+ * delivered events to the server and the cursor never moved.
+ *
+ * Calibration below was measured on this device (Sharp SL-C760, ads7846)
+ * by touching opposite screen corners and reading the raw values back.
+ * The panel does not use the driver's full 0..4095 ADC range, and
+ * absinfo's advertised min/max is the ADC range rather than the reachable
+ * one, so scaling by absinfo would squash the usable area toward the
+ * middle of the screen. Both axes increase in the same direction as the
+ * screen (raw X left->right, raw Y top->bottom), so no swap or inversion.
+ *
+ * To re-measure: run Xfbdev, touch the corners, and read the raw pairs --
+ * see docs/HOWTO-X11-TOUCHSCREEN.md.
+ */
+#define EVDEV_ABS_CAL_XMIN 221
+#define EVDEV_ABS_CAL_XMAX 3807
+#define EVDEV_ABS_CAL_YMIN 282
+#define EVDEV_ABS_CAL_YMAX 3800
+
+static int
+EvdevPtrScale (int v, int lo, int hi, int span)
+{
+    if (hi <= lo || span <= 1)
+        return 0;
+    if (v < lo)
+        v = lo;
+    if (v > hi)
+        v = hi;
+    return (v - lo) * (span - 1) / (hi - lo);
+}
+
+/* TRUE, with sx/sy set to screen coords, if this is an absolute device. */
+static Bool
+EvdevPtrAbsolute (KdPointerInfo *pi, int *sx, int *sy)
+{
+    Kevdev    *ke = pi->driverPrivate;
+    ScreenPtr pScreen;
+
+    if (!ke)
+        return FALSE;
+    if (!ISBITSET (ke->absbits, ABS_X) || !ISBITSET (ke->absbits, ABS_Y))
+        return FALSE;
+    if (screenInfo.numScreens < 1)
+        return FALSE;
+    pScreen = screenInfo.screens[0];
+
+    *sx = EvdevPtrScale (ke->abs[ABS_X], EVDEV_ABS_CAL_XMIN, EVDEV_ABS_CAL_XMAX,
+                         pScreen->width);
+    *sy = EvdevPtrScale (ke->abs[ABS_Y], EVDEV_ABS_CAL_YMIN, EVDEV_ABS_CAL_YMAX,
+                         pScreen->height);
+    return TRUE;
+}
+
+/*
+ * Emit one absolute event per EV_SYN frame. Absolute position means the
+ * KD_MOUSE_DELTA flag must NOT be set -- KdEnqueuePointerEvent() keys off
+ * it to decide POINTER_RELATIVE vs POINTER_ABSOLUTE.
+ */
+static void
+EvdevPtrSync (KdPointerInfo *pi)
+{
+    Kevdev *ke = pi->driverPrivate;
+    int    sx, sy, flags;
+
+    if (!ke || !ke->abs_pending)
+        return;
+    ke->abs_pending = 0;
+
+    if (!EvdevPtrAbsolute (pi, &sx, &sy))
+        return;
+
+    flags = ke->touch_down ? KD_BUTTON_1 : 0;
+    KdEnqueuePointerEvent (pi, flags, sx, sy, 0);
+}
