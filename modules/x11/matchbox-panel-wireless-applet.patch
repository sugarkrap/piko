 #include <sys/types.h>
 #include <sys/ioctl.h>
+/* update_wireless() scales link quality with rint() and log(). math.h was
+ * never included, so both were implicitly declared as returning int --
+ * which silently truncated the result on older compilers and is a hard
+ * error on anything modern. */
+#include <math.h>
 
 #include <netdb.h>      /* gethostbyname, getnetbyname */
 #if 0
@@ -138,9 +143,15 @@
