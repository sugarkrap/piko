#!/bin/sh
#
# Installed as /etc/matchbox/session. matchbox-session (from
# matchbox-common) prefers $HOME/.matchbox/session, then this file, then
# falls back to its own built-in default -- which starts the panel with no
# arguments at all. That fallback is why the panel only ever showed two
# applets: with no --default-apps, matchbox-panel uses the compiled-in
# DEFAULT_SESSIONS, which is exactly
# "mb-applet-menu-launcher,mb-applet-clock" (src/session.c:3).
#
# --no-session is not optional here. Without it the panel reads
# $HOME/.matchbox/mbdock.session if that file exists and ignores
# --default-apps completely (src/session.c:73-99) -- and the panel *writes*
# that file on every clean exit. So a device that has ever run the panel
# has a stale two-applet list on disk that would silently override
# whatever we ask for here. --no-session also stops it being rewritten,
# which is what we want on an appliance: the applet list is defined here,
# in tracked source, and is identical on every boot.
#
# All --default-apps entries dock at the same gravity (END, i.e. the right
# of a south-oriented panel) in list order. Per-applet placement needs the
# mbdock.session file format instead, which is not worth reintroducing the
# stale-state problem for.

# ORDER MATTERS, and it runs RIGHT TO LEFT. panel_app_add_end() gives the
# first END-gravity applet offset = panel_width - size, i.e. the right edge,
# and each one after that sits to its left. So the clock being first is what
# puts it at the far right end of the panel.
#
# mb-applet-menu-launcher and mb-applet-tasks are the exceptions: both call
# mb_tray_app_request_offset(-1) themselves and end up on the LEFT
# regardless, in the order they dock. They are listed last, after the
# right-hand group, so this list still reads right-to-left honestly -- and
# the taskbar is listed after the menu button so the menu button lands
# furthest left, with the taskbar growing rightwards from beside it.
#
# -s 16 shrinks the clock font. Without it the clock sizes its font to the
# full tray height (32px here), which fills the panel edge to edge and makes
# the applet wide, because its requested width is the rendered width of
# "99999" in that font. Tune this number, not the panel size.
APPLETS="mb-applet-clock -s 16"
# Right-to-left list order (see above) puts mb-volume just left of the
# clock and system-monitor just left of that -- i.e. reading the panel
# left-to-right: ...system-monitor, volume, clock.
APPLETS="$APPLETS,mb-volume"
APPLETS="$APPLETS,mb-applet-system-monitor"
APPLETS="$APPLETS,mb-applet-battery"
APPLETS="$APPLETS,mb-applet-wireless"
# Self-hiding: mb-applet-card shows a tray icon only while an SD or CF
# card is actually inserted, so it costs nothing to always start it.
APPLETS="$APPLETS,mb-applet-card"
# mb-brightness docks NOTHING -- ever. It hides itself before the main
# loop starts (the same trick mb-applet-card uses for an empty slot, but
# permanent), so the panel never creates a window or reserves a pixel for
# it. Its only job is to draw the backlight OSD at the top of the screen
# when brightd pokes it on Fn+3/Fn+4. Its position in this list is
# therefore irrelevant to the panel layout -- it is here purely so it
# starts and stops with the session. See docs/HOWTO-BRIGHTNESS.md.
APPLETS="$APPLETS,mb-brightness"
APPLETS="$APPLETS,mb-applet-menu-launcher"
# The taskbar: one button per running application, with its icon, its name
# and a count when it has several windows. Also self-hiding -- with nothing
# open it docks no window at all, so the panel looks exactly as it did
# before until there is a task to show. It claims the space between the
# menu button and the leftmost right-hand applet, working the free width
# out for itself from the panel's own applet list, so nothing here needs
# adjusting when applets come and go.
APPLETS="$APPLETS,mb-applet-tasks"

# Not enabled:
#
#   mb-launcher-term     mb-applet-launcher -o -1 -l mbterm.png \
#                            mb-applet-xterm-wrapper.sh
#                        The wrapper execs rxvt or xterm; the payload
#                        ships neither, so this would be a dead button.
#                        Add it here once a terminal is in the image.

matchbox-desktop &

matchbox-panel --orientation south --no-session --default-apps "$APPLETS" &

# -use_cursor no: this device has a touchscreen, not a mouse, so the
# pointer only ever appears where a finger just was and serves no
# purpose. matchbox-window-manager already supports hiding it natively
# (wm_set_cursor_visibility() in src/wm.c) -- no Xfixes needed, it just
# swaps the root window's cursor for a 1x1 transparent pixmap one.
#
# -theme Piko: the stock Default theme puts a 16x20 close button in the
# extreme top-right corner of the screen, which is the worst place to put a
# small target on a resistive digitiser -- the corners are where it is least
# linear, so taps read a few pixels inward and miss the button entirely.
# That is why closing a window "sometimes did nothing". Piko is Default with
# a 36px titlebar (the height matchbox-panel gives itself here, see
# panel.c:1766) and 48x36 buttons flush against the screen edges, so a tap
# anywhere in the corner block lands on the button. Same colours and fonts.
#
# Absolute path, not a bare name: /usr/local/bin comes first on this
# device's PATH (see /etc/init.d/xsession) and has repeatedly ended up
# holding a stale hand-built standalone matchbox-window-manager (theming
# compiled out -- it silently ignores -theme Piko and logs "no _MB_THEME
# set on root window" from every client). The packaged build always
# installs to /usr/bin (prefix=/usr), so pin the exec there and stop a
# leftover /usr/local/bin copy from shadowing it.
exec /usr/bin/matchbox-window-manager -use_cursor no -theme Piko "$@"
