#!/bin/sh
PM=${PHONEME_HOME:-/usr/local/lib/phoneme}
LOGDIR=${PHONEME_LOG_DIR:-/mnt/card/.zaurus/var/log/phoneme}
PIKO_CFG=${PIKO_PHONEME_CFG:-/etc/piko/phoneme.cfg}
TIMIDITY_DEFAULT=/usr/share/timidity
HEAP_MB_DEFAULT=12
LOG_MAX=262144

JAR=$1
[ -n "$JAR" ] || exit 2
[ -x "$PM/bin/runMidlet" ] || exit 1

case "$JAR" in
	/mnt/card/*) ZROOT=/mnt/card/.zaurus ;;
	/mnt/cf/*)   ZROOT=/mnt/cf/.zaurus ;;
	*)           ZROOT=/usr/local/.zaurus ;;
esac
CFG=${EMULATION_CFG:-$ZROOT/emulation.cfg}

slug=$(basename "$JAR")
slug=${slug%.*}
slug=$(printf '%s' "$slug" | tr -c 'A-Za-z0-9._-' '_')
LOG=${PHONEME_LOG:-$LOGDIR/$slug.log}

mkdir -p "${LOG%/*}" 2>/dev/null

if [ -f "$LOG" ]; then
	size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
	if [ "$size" -gt "$LOG_MAX" ]; then
		mv "$LOG" "$LOG.old" 2>/dev/null
	fi
fi

{
	echo "---- phoneme-run $(date 2>/dev/null) ----"
	echo "jar:  $JAR"
	echo "pid:  $$"
} >> "$LOG"

suite=
rotate=
canvas=
if [ -f "$CFG" ]; then
	while IFS='|' read -r p machine backend desktop icon options; do
		[ "$p" = "$JAR" ] || continue
		OLD=$IFS
		IFS=','
		for kv in $options; do
			case "$kv" in
				suite=*) suite=${kv#suite=} ;;
				rotate=*) rotate=${kv#rotate=} ;;
				canvas=*) canvas=${kv#canvas=} ;;
			esac
		done
		IFS=$OLD
		break
	done < "$CFG"
fi

if [ -z "$suite" ]; then
	echo "phoneme-run: $JAR has no installed suite, installing now" >> "$LOG"
	out=$("$PM/bin/installMidlet" "file:///$JAR" 2>&1)
	echo "$out" >> "$LOG"
	suite=$(echo "$out" | while read -r line; do
		case "$line" in
			*"installed, ID:"*) echo "${line##*: }" ;;
		esac
	done | head -n 1)
fi

if [ -z "$suite" ]; then
	echo "phoneme-run: no suite id for $JAR, giving up" >> "$LOG"
	exit 3
fi

if [ "$rotate" = "1" ]; then
	J2ME_GP2X_REVERSE=1
	export J2ME_GP2X_REVERSE
fi

if [ -n "$canvas" ]; then
	PIKO_CANVAS=$canvas
	export PIKO_CANVAS
fi

if [ -f "$PIKO_CFG" ]; then
	while IFS='=' read -r key value; do
		case "$key" in
			timidity_dir) [ -n "${PIKO_TIMIDITY_DIR:-}" ] || PIKO_TIMIDITY_DIR=$value ;;
			midi_amplification) [ -n "${PIKO_MIDI_AMP:-}" ] || PIKO_MIDI_AMP=$value ;;
			eventlog) [ -n "${PIKO_EVENTLOG:-}" ] || { [ "$value" = "1" ] && PIKO_EVENTLOG=1; } ;;
			keylog) [ -n "${PIKO_KEYLOG:-}" ] || { [ "$value" = "1" ] && PIKO_KEYLOG=1; } ;;
			quit_key) [ -n "${PIKO_QUIT_KEY:-}" ] || PIKO_QUIT_KEY=$value ;;
			quit_hard) [ -n "${PIKO_QUIT_HARD:-}" ] || { [ "$value" = "1" ] && PIKO_QUIT_HARD=1; } ;;
			quit_hold_ms) [ -n "${PIKO_QUIT_HOLD_MS:-}" ] || PIKO_QUIT_HOLD_MS=$value ;;
			heap_mb) [ -n "${PIKO_HEAP_MB:-}" ] || PIKO_HEAP_MB=$value ;;
			vm_args) [ -n "${PIKO_VM_ARGS:-}" ] || PIKO_VM_ARGS=$value ;;
		esac
	done < "$PIKO_CFG"
fi

if [ -n "${PIKO_MIDI_AMP:-}" ]; then
	export PIKO_MIDI_AMP
fi

if [ -n "${PIKO_EVENTLOG:-}" ]; then
	export PIKO_EVENTLOG
fi

if [ -n "${PIKO_KEYLOG:-}" ]; then
	export PIKO_KEYLOG
fi

if [ -n "${PIKO_QUIT_KEY:-}" ]; then
	export PIKO_QUIT_KEY
fi

if [ -n "${PIKO_QUIT_HARD:-}" ]; then
	export PIKO_QUIT_HARD
fi

if [ -n "${PIKO_QUIT_HOLD_MS:-}" ]; then
	export PIKO_QUIT_HOLD_MS
fi
PIKO_TIMIDITY_DIR=${PIKO_TIMIDITY_DIR:-$TIMIDITY_DEFAULT}
export PIKO_TIMIDITY_DIR

if [ ! -f "$PIKO_TIMIDITY_DIR/timidity.cfg" ]; then
	echo "phoneme-run: no timidity.cfg under $PIKO_TIMIDITY_DIR, midi will be silent" >> "$LOG"
fi

PIKO_HEAP_MB=${PIKO_HEAP_MB:-$HEAP_MB_DEFAULT}

{
	echo "suite: $suite"
	echo "heap: ${PIKO_HEAP_MB}M"
	echo "vm_args: ${PIKO_VM_ARGS:-(none)}"
	echo "rotate: ${rotate:-0}"
	echo "timidity: $PIKO_TIMIDITY_DIR"
	echo "midi_amp: ${PIKO_MIDI_AMP:-default}"
	echo "canvas: ${PIKO_CANVAS:-full}"
	echo "display: ${DISPLAY:-(unset)}"
	echo "quit key: ${PIKO_QUIT_KEY:-285}${PIKO_QUIT_HARD:+ (hard)} hold ${PIKO_QUIT_HOLD_MS:-3000}ms"
	echo "keylog: ${PIKO_KEYLOG:-0}"
	echo "---- runMidlet output ----"
} >> "$LOG"

cd "$PM/bin" || exit 1
exec ./runMidlet ${PIKO_VM_ARGS:-} "=HeapCapacity${PIKO_HEAP_MB}M" "$suite" >> "$LOG" 2>&1
