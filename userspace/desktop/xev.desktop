[Desktop Entry]
Type=Application
Name=xev
Comment=Show X keyboard and pointer events
# Absolute paths on both halves: PATH on this device is only
# /bin:/sbin:/usr/bin:/usr/sbin (rootfs/etc/profile), and BOTH st and xev
# live in /usr/local/bin, so neither resolves by bare name from the
# session -- matchbox-desktop inherits init's environment, not a login
# shell's.
#
# Wrapped in st because xev only ever writes to stdout. Launched bare from
# the desktop its output would be inherited from matchbox-session, which
# /etc/init.d/xsession redirects to /tmp/matchbox-session.log -- and /tmp
# here is jffs2 on NAND, not tmpfs, so every event line would be a flash
# write. In a terminal the events are visible live and nothing is written
# at all, which is the entire point of running this.
Exec=/usr/local/bin/st -e /usr/local/bin/xev
Icon=mbterm.png
Terminal=false
Categories=System;
