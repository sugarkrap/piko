[Desktop Entry]
Name=Go to TTY
Comment=Exit the graphical session to a text console
Exec=/usr/sbin/gototty
Icon=gototty.png
Terminal=false
Categories=Action;
# See suspend.desktop's comment: Categories=Action is what puts this at
# the ROOT of the panel menu rather than inside the System folder, and
# what keeps it off the desktop icon view. No Type= on purpose.
