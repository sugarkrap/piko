# System-wide shell profile (sourced by login shells: ash reads this via
# /bin/login, zsh reads it too when invoked as a login shell before ~/.zprofile).
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TERM=linux

# Timezone. Both the RTC and the system clock keep UTC -- TZ only decides
# how a time is *displayed*, never what is stored (see `settime help` and
# docs/HOWTO-RTC-TIME.md).
#
# The uClibc binaries we build ourselves (the whole X11/Matchbox stack)
# read /etc/TZ on their own whenever TZ is unset, so the panel clock needs
# nothing from here. The stage-2 busybox baked into NAND is an older build
# that only honours the environment variable, so export it for `date`.
[ -r /etc/TZ ] && export TZ="$(cat /etc/TZ)"

# Software living on the SD card (/mnt/card/.zaurus). Sourced rather than
# inlined so /etc/zshrc gets exactly the same behaviour from one file.
# Harmless with no card inserted -- see the file for why the PATH entry is
# added unconditionally.
[ -r /etc/zaurus-card.sh ] && . /etc/zaurus-card.sh
export TERMINFO=/usr/share/terminfo
export PAGER=less
export EDITOR=vi

# Only ash/sh honour PS1 from here; zsh uses ~/.zshrc.
if [ -z "$ZSH_VERSION" ]; then
	PS1='\u@\h:\w\$ '
fi

umask 022
