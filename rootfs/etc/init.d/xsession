#!/bin/sh

XSERVER=/usr/local/bin/Xfbdev
SESSION=/usr/bin/matchbox-session
XLOG=/tmp/xfbdev.log
SLOG=/tmp/matchbox-session.log

KBD_DEV=/dev/input/event1
PTR_DEV=/dev/input/event2

fallback_to_console() {
	echo ""
	echo "=== graphical session unavailable: $1 ==="
	echo "=== falling back to a console login on this tty ==="
	echo "=== X server log: $XLOG ==="
	echo ""
	exec /sbin/getty -L 38400 tty1 linux
}

[ -x "$XSERVER" ] || fallback_to_console "$XSERVER missing"
[ -x "$SESSION" ] || fallback_to_console "$SESSION missing (matchbox-common not installed?)"

XSERVER_NAME=$(basename "$XSERVER")

for lock in /tmp/.X*-lock; do
	[ -e "$lock" ] || continue
	lockpid=$(cat "$lock" 2>/dev/null | tr -dc '0-9')
	lockcomm=""
	[ -n "$lockpid" ] && [ -r "/proc/$lockpid/comm" ] && lockcomm=$(cat "/proc/$lockpid/comm" 2>/dev/null)
	if [ "$lockcomm" = "$XSERVER_NAME" ]; then
		echo "xsession: $lock held by live $XSERVER_NAME pid $lockpid, leaving it alone"
		continue
	fi
	if [ -n "$lockpid" ] && [ -d "/proc/$lockpid" ]; then
		echo "xsession: $lock names pid $lockpid but that is ${lockcomm:-unknown}, not $XSERVER_NAME"
	fi
	echo "xsession: removing stale $lock (pid ${lockpid:-unknown})"
	rm -f "$lock"
	display=$(basename "$lock" | sed -e 's/^\.X//' -e 's/-lock$//')
	rm -f "/tmp/.X11-unix/X$display"
done

"$XSERVER" -retro \
	-keybd "evdev,,device=$KBD_DEV" \
	-mouse "evdev,,device=$PTR_DEV" \
	> "$XLOG" 2>&1 &

i=0
while [ "$i" -lt 60 ]; do
	[ -e /tmp/.X11-unix/X0 ] && break
	sleep 1
	i=$((i + 1))
done
[ -e /tmp/.X11-unix/X0 ] || fallback_to_console "X server did not start within 60s"

DISPLAY=:0
export DISPLAY

if [ -x /usr/bin/xkbcomp ] && [ -f /etc/X11/zaurus.xkb ]; then
	/usr/bin/xkbcomp -I/usr/share/X11/xkb /etc/X11/zaurus.xkb "$DISPLAY" >>"$XLOG" 2>&1 \
		|| echo "xsession: xkbcomp failed, keyboard stays on the server default" >>"$XLOG"
fi

HOME=/root
export HOME

PATH=/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH
if [ -r /etc/zaurus-card.sh ]; then
	. /etc/zaurus-card.sh
fi

if [ -x /usr/bin/piko-sync-server ]; then
	/usr/bin/piko-sync-server --resync >/dev/null 2>&1
fi

"$SESSION" > "$SLOG" 2>&1

fallback_to_console "session exited"
