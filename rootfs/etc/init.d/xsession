#!/bin/sh
# Bring up the graphical session: Xfbdev -> Zaurus keymap -> Matchbox.
#
# Run from inittab in place of the tty1 getty, so the device boots
# straight to the desktop instead of an ash prompt. inittab respawns
# this, so it must NOT exit quickly on failure or init will spin: the
# failure paths below all fall back to a console login on this tty, which
# also means a broken X never leaves the machine unusable.
#
# Recovery, in order of preference:
#   * SSH still works regardless -- dropbear starts in rcS, before this.
#   * If X fails, this drops you to a login on tty1 anyway.
#   * To disable permanently: comment the tty1 line in /etc/inittab back
#     to the getty version and reboot.
#
# Device notes: PATH does not include /usr/local/bin, where Xfbdev lives,
# so paths here are absolute. There is no tmpfs /tmp on this rootfs (it
# is jffs2), so logs here hit flash -- keep them small.

XSERVER=/usr/local/bin/Xfbdev
SESSION=/usr/bin/matchbox-session
XLOG=/tmp/xfbdev.log
SLOG=/tmp/matchbox-session.log

# event1 = matrix-keypad (the built-in keyboard), event2 = ADS7846
# touchscreen. kdrive's auto-detection cannot be relied on here: it takes
# the first /dev/input/eventN that *opens*, not the first that is really a
# pointer, so it would grab event0 (gpio-keys-polled) and the touchscreen
# would never be used. Both devices are therefore named explicitly.
KBD_DEV=/dev/input/event1
PTR_DEV=/dev/input/event2

fallback_to_console() {
	echo ""
	echo "=== graphical session unavailable: $1 ==="
	echo "=== falling back to a console login on this tty ==="
	echo "=== X server log: $XLOG ==="
	echo ""
	exec /sbin/getty -L 38400 tty1 linux
}

[ -x "$XSERVER" ] || fallback_to_console "$XSERVER missing"
[ -x "$SESSION" ] || fallback_to_console "$SESSION missing (matchbox-common not installed?)"

# X refuses to start if /tmp/.X<n>-lock exists: "Server is already active for
# display 0". On a desktop that file is in a tmpfs and vanishes on reboot,
# but /tmp here is on the root jffs2, so a server that died without cleaning
# up -- a crash, or a power cut, or a reboot mid-write -- leaves the lock
# behind FOREVER. Every subsequent boot then comes up to a console with no
# X at all, and the cause is four lines down a log nobody reads.
#
# So sweep stale locks, but never one that something is genuinely holding:
# the file contains the server's pid, so /proc/<pid> answers that. There is
# no kill, pgrep or fuser on this device to ask any other way.
for lock in /tmp/.X*-lock; do
	[ -e "$lock" ] || continue		# no glob match
	lockpid=$(cat "$lock" 2>/dev/null | tr -dc '0-9')
	if [ -n "$lockpid" ] && [ -d "/proc/$lockpid" ]; then
		echo "xsession: $lock held by live pid $lockpid, leaving it alone"
		continue
	fi
	echo "xsession: removing stale $lock (pid ${lockpid:-unknown} is gone)"
	rm -f "$lock"
	# A dead socket alongside it confuses clients that get as far as
	# connecting, so clear that too -- but only now that the lock is gone.
	display=$(basename "$lock" | sed -e 's/^\.X//' -e 's/-lock$//')
	rm -f "/tmp/.X11-unix/X$display"
done

"$XSERVER" -retro \
	-keybd "evdev,,device=$KBD_DEV" \
	-mouse "evdev,,device=$PTR_DEV" \
	> "$XLOG" 2>&1 &

# Wait for the server to actually accept connections rather than sleeping
# a fixed amount: cold-start here includes fontconfig building its cache,
# which is slow on a 400MHz part with no fc-cache binary shipped.
i=0
while [ "$i" -lt 60 ]; do
	[ -e /tmp/.X11-unix/X0 ] && break
	sleep 1
	i=$((i + 1))
done
[ -e /tmp/.X11-unix/X0 ] || fallback_to_console "X server did not start within 60s"

DISPLAY=:0
export DISPLAY

# init runs this with essentially no environment, so HOME is unset --
# every matchbox tool that looks under $HOME (themes, the wallpaper
# picker's persisted choice, ...) silently falls back to mb_util_get_
# homedir()'s /tmp default instead of finding anything here. This
# session runs as root (see the file header), so give it root's real
# home rather than leave HOME unset.
HOME=/root
export HOME

# PATH has to be set here, and cannot be inherited. init runs this script
# with essentially no environment, and nothing in a graphical session ever
# reads /etc/profile -- that is a login-shell file and this is not a login
# shell. So the SD card's binary directory, which /etc/zaurus-card.sh puts
# on PATH for shells, is NOT on PATH for anything launched by tapping an
# icon unless it is added right here.
#
# Without it, an application installed onto a card (pkgadd ... card) gets
# an icon -- matchbox-desktop scans the card's applications directory --
# and then silently does nothing when tapped, because matchbox-desktop
# runs the .desktop file's Exec= line through the shell and the shell
# cannot find the binary. The icon appearing but not working is a
# considerably more confusing failure than no icon at all.
#
# /usr/local/bin is included because the X server and this project's own
# small tools live there. zaurus-card.sh is sourced rather than the card
# path being written out again, so ZAURUS_CARD_ROOT stays defined in
# exactly one file.
PATH=/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH
if [ -r /etc/zaurus-card.sh ]; then
	. /etc/zaurus-card.sh
fi

# Zaurus keyboard layout: NOT uploaded here any more.
#
# The server is now BUILT with it -- --with-xkb-default-rules=evdev and
# --with-xkb-default-layout=zaurus (tools/build-x11-stack.sh) -- so the
# keymap it compiles for itself at startup is already "pc+zaurus" against
# evdev keycodes, which is exactly what this step used to ask for.
#
# Uploading it live never worked. `xkbcomp zaurus.xkb :0` returns success,
# and the keycode SET does change, but the symbols do not: dumping the
# running keymap afterwards showed stock <AE02> = 2/at rather than this
# layout's 2/quotedbl, and <FK03> as plain F3 rather than the
# ISO_Level3_Shift that makes the whole Fn symbol layer work. So for as
# long as this line existed, the Fn layer, the Fn digit row and the
# Cut/Copy/Paste remaps were all silently absent -- the failure had no
# error to notice, because there was no error. See
# docs/DEADLETTER-XKB-LIVE-SETMAP.md for the related live-SetMap trouble.
#
# The layout still ships (/usr/share/X11/xkb/symbols/zaurus): the server
# reads it from there when it builds its own keymap. /etc/X11/zaurus.xkb
# is kept too, as the hand-testable equivalent -- `xkbcomp -I/usr/share/X11/xkb
# /etc/X11/zaurus.xkb :0` is still the way to try a layout edit against a
# running server without rebuilding.

# matchbox-session execs matchbox-window-manager after backgrounding the
# desktop and panel, so this blocks for the life of the session. If the
# user exits the WM, fall through to a console rather than letting init
# respawn us into a loop.
"$SESSION" > "$SLOG" 2>&1

fallback_to_console "session exited"
