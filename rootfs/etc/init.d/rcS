#!/bin/sh
# zaurus-refresh stage-2 system init (run once by BusyBox init as sysinit).

# ***********************************************************************
# *  BUILD MARKER: STAGE2-BUILD-B  (ssh-key + MD5-shadow + noqueue-fix) *
# *  If you see "STAGE2-BUILD-B" on boot, the LATEST mtd3 image is live.*
# ***********************************************************************
echo ""
echo "########  STAGE2-BUILD-G  (ash default + editable shell)  ########"
echo ""

# --- console noise ---
# Default console_loglevel (7) shows KERN_DEBUG messages too, which floods
# the physical console with things like spi-pxa2xx's per-transfer "NNNN Hz
# actual, PIO" dev_dbg() line (found 2026-07-27) -- harmless but makes the
# console unreadable. Drop to KERN_INFO(6): keeps boot/driver notices
# visible, silences debug-level chatter.
echo "6 4 1 7" > /proc/sys/kernel/printk 2>/dev/null

# --- virtual filesystems ---
mount -t proc     proc     /proc            2>/dev/null
mount -t sysfs    sysfs    /sys             2>/dev/null
# devtmpfs is auto-mounted by the kernel (CONFIG_DEVTMPFS_MOUNT), but mount
# again harmlessly in case it wasn't.
mount -t devtmpfs devtmpfs /dev             2>/dev/null

# --- compressed RAM swap (zram), ahead of the SD card's ---
# CONFIG_ZRAM is built into this kernel, so /dev/zram0 already exists by
# the time this runs -- no modprobe needed. zramswap sets it up as a
# second swap area and swapon(2)s it at a priority that always beats the
# card's (see userspace/src/zramswap.c and docs/HOWTO-SWAP.md): a page
# that compresses even 2:1 is cheaper to keep in RAM than to write
# anywhere, and unlike the card's it needs no card to be present at all.
# Run here, right after /sys and /dev are up (zramswap needs
# /sys/block/zram0) and long before the card's swap can possibly come up
# -- that waits on mdev's coldplug scan much later in this script.
#
# Never fatal: if the binary is missing (a deploy from before this
# existed) or this kernel lacks CONFIG_ZRAM, the machine just has less
# swap, not none -- the card path below is unaffected either way.
if test -x /usr/sbin/zramswap; then
    /usr/sbin/zramswap on >/tmp/zramswap.log 2>&1 || true
fi

# --- boot splash, continued from stage 1 ---
# The bootstrap draws this same picture before it kexecs (see
# docs/HOWTO-BOOT-SPLASH.md); redrawing it here as early as /dev exists is
# what makes it look like one continuous splash rather than a white flash
# between two kernels.
#
# Drawn with piko-splash, not `cat`. This rootfs's busybox is prebuilt in
# the mtd3 image with no fbsplash applet and no gzip/gunzip/zcat -- so the
# obvious move is a raw RGB565 dump piped straight to the device. That does
# not work here: w100fb has no usable write() path and `cat` fails with
#
#     cat: write error: Invalid argument
#
# The framebuffer has to be mmap'd (which is also why fbsplash works in
# stage 1). piko-splash is the smallest thing that does that -- see
# userspace/src/piko-splash.c. The image is emitted from the same master
# artwork as the stage-1 PPM by tools/make-splash.py, so the two halves of
# the splash cannot drift apart.
#
# Never fatal, and it must not hold up boot: if /dev/fb0 is missing or the
# asset is gone, we lose a picture, not the system.
if test -x /usr/sbin/piko-splash && test -f /usr/share/piko/splash.raw; then
    if /usr/sbin/piko-splash /usr/share/piko/splash.raw 2>/dev/null; then
        # The picture is up, so stop writing text on top of it.
        #
        # Making stage 2's *kernel* quiet (CONFIG_CMDLINE, see #110) only
        # silences printk. Everything below is userspace writing to the
        # console -- a dozen or so status echoes -- and it scribbles across
        # the splash just as effectively. Rebind to a log instead.
        #
        # Deliberately inside the success branch: if the splash did NOT
        # draw, the console is the only thing we have and it stays exactly
        # as it was. We only go quiet when we have actually put something
        # there worth keeping, so a boot with no picture is never also a
        # boot with no output.
        exec > /tmp/rcS.log 2>&1
    fi
fi

mkdir -p /dev/pts
mount -t devpts   devpts   /dev/pts  -o mode=0620,ptmxmode=0666  2>/dev/null
# dropbear opens /dev/ptmx to allocate a pseudo-terminal, but devtmpfs does
# NOT create it. It must point at THIS devpts instance's own clone device
# (/dev/pts/ptmx, created by the ptmxmode= mount option above) via a symlink,
# so the master (from /dev/ptmx) and the slave (from ptsname() -> /dev/pts/N)
# live in the SAME instance and are actually paired. A plain "mknod ptmx c 5 2"
# node allocates the master in the kernel's *default* devpts instance instead,
# so the PTY is granted and the shell runs but its output never flows back
# (SSH gets an interactive session that closes with no output). Symlink first,
# fall back to a static node only if the instance ptmx is missing.
if test -e /dev/pts/ptmx; then
    ln -sf pts/ptmx /dev/ptmx
else
    test -e /dev/ptmx || mknod /dev/ptmx c 5 2
    chmod 666 /dev/ptmx 2>/dev/null
fi

hostname zaurus

# --- clock ---
# The kernel already sets the system clock from the RTC during boot
# (CONFIG_RTC_DRV_SA1100=y feeding CONFIG_RTC_HCTOSYS), so in the normal
# case there is nothing to do here and the `hwclock -s` below is a no-op
# that costs one ioctl.
#
# The check exists for the abnormal case: before the driver was built in it
# was CONFIG_RTC_DRV_SA1100=m and nothing ever loaded it, so there was no
# /dev/rtc0, hctosys never ran, and every boot started at the epoch --
# 00:00 1970-01-01, which then timestamps every file written this session.
# If someone boots an older zImage that is exactly what happens again, so
# say it out loud rather than letting 1970 go unnoticed.
if test -e /dev/rtc0; then
	test -x /usr/sbin/hwclock && /usr/sbin/hwclock -s 2>/dev/null
else
	echo "rcS: no /dev/rtc0 -- the clock starts at the epoch this boot"
	echo "rcS: needs CONFIG_RTC_DRV_SA1100=y (see docs/HOWTO-RTC-TIME.md)"
fi

# The mtd3 image is built with mkfs.jffs2 -q (everything squashed to root),
# so piko's home ends up root-owned and piko's shell can't write its
# history / completion dump. Give piko ownership of its own home at boot.
chown -R piko:piko /home/piko 2>/dev/null
chmod 700 /home/piko/.ssh 2>/dev/null
chmod 600 /home/piko/.ssh/authorized_keys 2>/dev/null

# --- hotplug / module auto-load manager ---
# UEVENT_HELPER is off in this kernel, so run mdev as a netlink daemon
# rather than via /proc/sys/kernel/hotplug. On card/device insertion it
# consults /etc/mdev.conf and modprobes the matching driver.
mdev -d 2>/dev/null &

# --- hostap in CLIENT mode ---
# hostap ("host AP") defaults the card to Master/AP mode (iw_mode 3).
# Switching Master->Managed at runtime resets the firmware and misbehaves
# (card associates + scans but passes no data initially, WARN_ON in
# prism2_interrupt, two "Association failed" events before it finally
# connects several seconds later -- this is the actual cause of the WiFi
# flakiness seen vs. Cacko, not a hotplug/hardware issue).
#
# iw_mode is NOT a parameter of the "hostap" core module -- it's declared
# in hostap_hw.c, which hostap_cs.c/hostap_pci.c/hostap_plx.c each
# #include directly (confirmed via `modinfo hostap_cs`), so it only
# exists on the bus-specific module actually bound to the card. An
# earlier attempt applied it to "hostap" instead, which silently ignores
# it ("hostap: unknown parameter 'iw_mode' ignored" in dmesg) and falls
# back to the buggy runtime switch every single time the card comes up.
# The real fix is in /etc/modprobe.d/hostap.conf (targets hostap_cs, so
# it's applied whenever mdev auto-loads it for an inserted card). Loading
# the core module here first is still required as a hostap_cs dependency.
modprobe hostap 2>/dev/null

# --- PCMCIA subsystem bring-up ---
# The socket/platform driver stack must be loaded BEFORE a card is
# inserted, so the kernel can actually detect insertion and fire the
# uevent mdev's MODALIAS rule catches (which then auto-loads hostap_cs +
# deps for the card itself). depmod's modules.dep doesn't show
# pxa2xx_sharpsl depending on pxa2xx_base (likely resolved via platform
# device registration, not a direct symbol call), so load both explicitly
# rather than relying purely on automatic dependency resolution.
modprobe pxa2xx_base 2>/dev/null
modprobe pxa2xx_sharpsl 2>/dev/null

# --- SPI bus (MAX1111 main-battery ADC, ads7846 touchscreen, corgi-lcd) ---
# corgi.c registers spi_board_info for these unconditionally at boot. The
# SSP port driver, the SPI_PXA2XX master driver, the ads7846 touchscreen
# driver, and the evdev/mousedev input-core handlers that turn its events
# into /dev/input/eventN + /dev/input/mice are all built into the kernel
# now (CONFIG_PXA_SSP/CONFIG_SPI_PXA2XX/CONFIG_TOUCHSCREEN_ADS7846/
# CONFIG_INPUT_EVDEV/CONFIG_INPUT_MOUSEDEV=y), so the SPI bus is already
# registered and the touchscreen already probed by the time this script
# runs -- no insmod needed, and no window where /sys/bus/spi/devices is
# empty (previously: sharpsl-pm logging "Warning: Cannot read main
# battery!" until these were manually loaded, in dependency order --
# ssp before spi-pxa2xx-platform -- since insmod does not resolve that
# automatically the way built-in link order does).
KVER="$(uname -r)"

# --- MMC/SD + VFAT ---
# MMC core/block and the pxamci host driver are built into the kernel
# (CONFIG_MMC/CONFIG_MMC_BLOCK/CONFIG_MMC_PXA=y), so the board's
# pxa2xx-mci.0 platform device is already bound and probing by the time
# this script runs -- no insmod needed, and no window where the host
# doesn't exist yet. FAT/VFAT and the common Cacko-era codepages are still
# modular, so those still need loading; ext4 is built into the kernel.
insmod "/lib/modules/$KVER/kernel/fs/nls/nls_cp437.ko" 2>/dev/null
insmod "/lib/modules/$KVER/kernel/fs/nls/nls_cp850.ko" 2>/dev/null
insmod "/lib/modules/$KVER/kernel/fs/nls/nls_iso8859-15.ko" 2>/dev/null
insmod "/lib/modules/$KVER/kernel/fs/fat/fat.ko" 2>/dev/null
insmod "/lib/modules/$KVER/kernel/fs/fat/vfat.ko" 2>/dev/null

# --- mdev coldplug: catch devices that were already present before the
# netlink daemon above was ready to hear about them ---
#
# `mdev -d &` (started near the top of this script) is a NETLINK listener:
# a uevent broadcast while nothing is bound yet is simply lost, not queued.
# On this board's slow single-core PXA255, forking mdev and having the
# child actually reach socket()/bind() can genuinely take longer than the
# handful of insmod lines above -- and now that MMC core/block/pxamci are
# built into the kernel rather than modules, an already-inserted card's
# add-uevent chain (mmc0 -> mmcblk0 -> mmcblk0p1) fires during kernel init,
# before rcS -- let alone the mdev daemon -- has even started, so this is
# no longer a narrow race for MMC, it's a certainty every boot. The kernel
# side works fine either way (confirmed via dmesg: "mmc0: new SD card",
# "mmcblk0: p1", the device node exists) -- what's lost is purely the
# userspace hotplug event, so /etc/mdev.conf's mmcblk0p1 rule (which mounts
# it) never runs, and a manual `mount /mnt/card` afterwards always works
# instantly. This is the exact race `mdev -s` (coldplug scan) exists to
# close: it re-walks /sys and re-fires every matching rule for whatever is
# ALREADY there, so a card already in the slot at boot gets mounted
# regardless of whether its hotplug event made it to the daemon in time.
# Placed after every module load above so /sys actually has something to
# find (PCMCIA/hostap's own MODALIAS rule benefits from this too -- a card
# already seated at boot was likely hitting the identical race, just
# unnoticed because WiFi cards here are normally inserted after boot,
# well past this window).
mdev -s 2>/dev/null

# piko-sync-server's deploy staging area (see resolve_staging_dir() in
# piko-sync-server.cxx) holds in-flight ".part" files for whatever deploy
# was running when the device last went down -- a reboot means that
# deploy session is definitely over, so anything left here is dead
# weight, not something to resume. Cleared every boot rather than left to
# accumulate; recreated on demand by the app itself, not here.
rm -rf /mnt/card/.zaurus/tmp 2>/dev/null

# --- audio stack (WM8731 codec via I2S, ALSA OSS emulation) ---
# Loads the same modules as the manual /usr/sbin/audioon helper (see
# flash/chunked-deploy.sh step 7) so /dev/dsp + /dev/mixer are ready at
# boot -- zplay and other OSS consumers no longer need "audioon" run by
# hand first. audioon itself already no-ops any module already loaded
# and creates the device nodes, so it's safe to just call it here.
if test -x /usr/sbin/audioon; then
	/usr/sbin/audioon 2>/dev/null
fi

# --- networking ---
ifconfig lo 127.0.0.1 up 2>/dev/null
# usb0 comes up once g_ether is loaded -- not wired up yet.
# wlan0 comes up automatically via mdev (see /etc/mdev.conf + /etc/wifi-up.sh)
# once a Prism2/hostap PCMCIA card is inserted.

# --- w100 display stability profile ---
# fastpllclk drives the W100 PLL from Corgi's .pll_freq (75MHz) up to its
# .fast_pll_freq (100MHz) -- see corgi_fb_modes[] in mach-pxa/corgi.c.
# It is the mainline equivalent of Cacko's /proc/driver/w100/fastsysclk,
# except mainline made it a boolean: Cacko took a target MHz, and the
# "echo 75" everyone passed around is already our *default*, so the only
# way up from here is 100MHz.
#
# Kept at 0. Tested against the LCD vertical-crosstalk artifact on
# 2026-07-31 with `fbtest blocks`: toggling 75 <-> 100MHz made NO visible
# difference, so there is nothing to gain here, while an earlier session
# found 0 eliminated a 1px horizontal jitter. Don't raise it again
# expecting a display-quality win -- see docs/DEADLETTER-LCD-CROSSTALK.md.
if test -w /sys/devices/platform/w100fb/fastpllclk; then
	echo 0 > /sys/devices/platform/w100fb/fastpllclk
fi
if test -w /sys/module/w100fb/parameters/force_fullrate; then
	echo Y > /sys/module/w100fb/parameters/force_fullrate
fi
if test -w /sys/module/w100fb/parameters/vsync_mode; then
	echo 0 > /sys/module/w100fb/parameters/vsync_mode
fi
if test -w /sys/module/w100fb/parameters/vsync_debug; then
	echo N > /sys/module/w100fb/parameters/vsync_debug
fi

# --- backlight level ---
# Re-apply the level saved by "bright save". Must run AFTER the SPI master
# modules above: corgi-lcd sits on spi1.1, so /sys/class/backlight/corgi_bl
# does not exist until spi-pxa2xx-platform.ko has registered the bus. With
# nothing saved this is a no-op and the driver's own default_intensity
# (0x1f = 31 of 47) stands.
if test -x /usr/sbin/bright; then
	/usr/sbin/bright restore 2>/dev/null
fi

# --- idle dimming / lid blanking ---
# Watches the evdev nodes directly rather than X: there is no xset on this
# rootfs, and this way the dimmer also works on the console and before the
# graphical session starts. Backgrounded with HUP ignored because this
# BusyBox has no nohup. Stop it with "pkillx brightd" (there is no plain
# kill on this rootfs); suppress dimming for video with
# "touch /tmp/brightd.inhibit" rather than stopping the daemon.
if test -x /usr/sbin/brightd; then
	trap "" HUP
	/usr/sbin/brightd 2>/dev/null &
	trap - HUP
fi

# --- screen rotation on the swivel hinge ---
# Turns the display 180 degrees when the lid is swivelled and folded flat.
# The rotation is done by the w100 CRTC during scanout (the "flip" sysfs
# attribute), so it costs a register write and moves no pixels -- see
# userspace/src/flipd.c. Started here rather than from the X session
# because it works on the console too, and because it must apply the
# current posture at boot, not at login. Stop it with "pkillx flipd";
# to disable it for good put enabled=0 in /etc/piko/rotation.cfg.
if test -x /usr/sbin/flipd; then
	trap "" HUP
	/usr/sbin/flipd 2>/dev/null &
	trap - HUP
fi

# --- ssh ---
mkdir -p /etc/dropbear
# Generate host keys on first boot (persisted to the jffs2 root).
if ! test -f /etc/dropbear/dropbear_ed25519_host_key; then
	echo "generating dropbear host keys (first boot)..."
	dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key 2>/dev/null
	dropbearkey -t rsa     -f /etc/dropbear/dropbear_rsa_host_key     2>/dev/null
fi
# -B: no fork-into-background management, -R: generate keys if missing.
# Listens on all interfaces; only reachable once an interface is up.
dropbear -R 2>/dev/null

echo ""
echo "=== zaurus-refresh stage 2 ready -- log in at the console ==="
echo ""

# --- console keymap: Zaurus C7x0 Fn=AltGr symbol layer (/ : [ ] | { } etc.) ---
/bin/busybox loadkmap < /etc/zaurus.bmap 2>/dev/null

# --- pending bootstrap (smf) update ---
# Only ever a notice. The smf write is deliberately NOT automatic: getting
# here at all is the proof that the newly installed stage-2 boots, and that
# proof is worthless if this script flashes NAND before anyone sees it.
# The user decides, with AC connected, by typing smfcommit.
if test -f /boot/smf-pending; then
	echo ""
	echo "  *** bootstrap update pending -- plug in AC and type: smfcommit ***"
	echo ""
fi
