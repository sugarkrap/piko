#!/bin/sh

DYNDBG=""
case "${1:-}" in
	-v|debug)	DYNDBG="dyndbg=+p" ;;
	"")		;;
	*)		echo "usage: irup [-v]"; exit 2 ;;
esac

echo "loading the irda stack..."
for m in irda pxaficp_ir ircomm ircomm-tty; do
	if ! modprobe "$m" $DYNDBG 2>/dev/null; then
		echo "irup: modprobe $m failed"
		echo "irup: check   dmesg | tail   and that /lib/modules/$(uname -r) has it"
		exit 1
	fi
done

waited=0
while ! test -d /sys/class/net/irda0 && test "$waited" -lt 5; do
	sleep 1
	waited=$((waited + 1))
done

if ! test -d /sys/class/net/irda0; then
	echo "irup: modules loaded but no irda0 appeared"
	echo "irup: pxaficp_ir did not bind pxa2xx-ir -- check   dmesg | tail"
	exit 1
fi

ifconfig irda0 up

if test -w /proc/sys/net/irda/discovery; then
	echo 1 > /proc/sys/net/irda/discovery
else
	echo "irup: no /proc/sys/net/irda/discovery, leaving discovery at its default"
fi

echo ""
echo "=== irda0 now ==="
ifconfig irda0
echo ""
if test -r /proc/net/irda/discovery; then
	echo "=== peers seen so far ==="
	cat /proc/net/irda/discovery
	echo ""
fi

if test -c /dev/ircomm0; then
	echo "irda0 up (SIR, 9600-115200), /dev/ircomm0 ready"
	echo "point it at the other machine's IR port, then:  microcom /dev/ircomm0"
else
	echo "irda0 up (SIR, 9600-115200), but there is no /dev/ircomm0"
	echo "ircomm-tty did not register -- check   dmesg | tail"
fi
echo "for diagnostics:  irinfo        for a chatty stack:  irup -v"
