#!/bin/sh

IRDA_LOAD="irda pxaficp_ir ircomm ircomm-tty"
IRDA_DROP="ircomm-tty ircomm pxaficp_ir irda"
CIR_LOAD="rc-core ir-nec-decoder ir-rc5-decoder ir-rc6-decoder ir-jvc-decoder ir-sony-decoder ir-sharp-decoder ir-sanyo-decoder piko-cir"
CIR_DROP="piko-cir ir-sanyo-decoder ir-sharp-decoder ir-sony-decoder ir-jvc-decoder ir-rc6-decoder ir-rc5-decoder ir-nec-decoder rc-core"

CIR_DEV="${IRMODE_CIR_DEV:-/dev/lirc0}"

load() {
	for m in $1; do
		if ! modprobe "$m" 2>/dev/null; then
			echo "irmode: modprobe $m failed"
			echo "irmode: check  dmesg | tail  and /lib/modules/$(uname -r)"
			return 1
		fi
	done
}

drop() {
	for m in $1; do
		modprobe -r "$m" 2>/dev/null
	done
}

case "${1:-status}" in
	on)
		load "$IRDA_LOAD" || exit 1
		load "$CIR_LOAD" || exit 1
		if ! test -c "$CIR_DEV"; then
			echo "irmode: loaded but no $CIR_DEV -- check  dmesg | tail"
			exit 1
		fi
		echo "ir on. both stacks loaded, neither holds the port."
		echo ""
		echo "blast:     ir tx frame.ir        (takes the port for the frame)"
		echo "learn:     ir rx > frame.ir      (holds it until you stop)"
		echo "transfer:  irup                  (holds it until irda0 goes down)"
		;;
	off)
		drop "$CIR_DROP"
		ifconfig irda0 down 2>/dev/null
		drop "$IRDA_DROP"
		echo "ir off, both stacks unloaded"
		;;
	gap)
		if test -z "${2:-}"; then
			cat /sys/module/piko_cir/parameters/carrier_gap 2>/dev/null \
				|| echo "irmode: piko-cir not loaded"
			exit 0
		fi
		if ! echo "$2" > /sys/module/piko_cir/parameters/carrier_gap 2>/dev/null; then
			echo "irmode: piko-cir not loaded"
			exit 1
		fi
		echo "carrier gap now ${2}us"
		;;
	status)
		if test -d /sys/class/net/irda0; then
			echo "irda:  loaded"
		else
			echo "irda:  not loaded"
		fi
		if test -c "$CIR_DEV"; then
			echo "cir:   loaded ($CIR_DEV)"
		else
			echo "cir:   not loaded"
		fi
		if ifconfig irda0 2>/dev/null | grep -q "UP"; then
			echo "port:  held by irda (irda0 is up)"
		else
			echo "port:  free unless something has $CIR_DEV open"
		fi
		if test -r /sys/module/piko_cir/parameters/rx_edges; then
			echo "edges: $(cat /sys/module/piko_cir/parameters/rx_edges)"
			echo "gap:   $(cat /sys/module/piko_cir/parameters/carrier_gap)us"
		fi
		;;
	*)
		echo "usage: irmode [on|off|status|gap [us]]"
		exit 2
		;;
esac
