#!/bin/sh
. /etc/piko-media
CARDSWAP=/usr/sbin/cardswap

if [ -n "$PIKO_BOOT_DEV" ] && [ "/dev/${MDEV:-}" = "$PIKO_BOOT_DEV" ]; then
	exit 0
fi

{
	[ -x "$CARDSWAP" ] && "$CARDSWAP" off >/dev/null 2>&1

	umount -l "$PIKO_CARD_MNT" 2>/dev/null

	if [ "$ACTION" != "remove" ]; then
		mount "$PIKO_CARD_MNT" 2>/dev/null
		[ -x "$CARDSWAP" ] && "$CARDSWAP" on >/tmp/cardswap.log 2>&1
	fi
} &

exit 0
