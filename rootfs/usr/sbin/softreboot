#!/bin/sh
set -eu
. /etc/piko-media

kexec -l "$PIKO_KERNEL" --atags --append="$(cat /proc/cmdline)"

sync
if [ "$PIKO_KIND" = img ]; then
	mount -o remount,ro / 2>/dev/null || true
	sync
	mount -o remount,ro "$PIKO_BOOT_MNT" 2>/dev/null || true
else
	umount -l "$PIKO_CARD_MNT" 2>/dev/null || true
fi

sync
exec kexec -e
