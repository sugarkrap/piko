#!/bin/sh
set -eu
test -r /etc/piko-media && . /etc/piko-media

APPEND="$(cat /proc/cmdline)"
BOOTCFG="${PIKO_BOOT_MNT:-/media/boot}/.zaurus/piko-boot.cfg"
if test -r "$BOOTCFG"; then
	CFGAPPEND=""
	while read -r key value; do
		case "$key" in
		append) CFGAPPEND="$value" ;;
		esac
	done < "$BOOTCFG"
	if test -n "$CFGAPPEND"; then
		ROOTARGS=""
		for arg in $(cat /proc/cmdline); do
			case "$arg" in
			pikoroot=*|root=*|rootfstype=*) ROOTARGS="$ROOTARGS $arg" ;;
			esac
		done
		APPEND="$CFGAPPEND$ROOTARGS"
	fi
fi

kexec -l "${PIKO_KERNEL:-/boot/zImage-full}" --atags --append="$APPEND"

sync
if [ "${PIKO_KIND:-mtd}" = img ]; then
	mount -o remount,ro / 2>/dev/null || true
	sync
	mount -o remount,ro "$PIKO_BOOT_MNT" 2>/dev/null || true
else
	umount -l "${PIKO_CARD_MNT:-/mnt/card}" 2>/dev/null || true
fi

sync
exec kexec -e
