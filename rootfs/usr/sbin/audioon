#!/bin/sh
set -eu

# The whole ALSA/OSS stack (soundcore, snd-soc-corgi, snd-soc-wm8731, ...)
# is built into the kernel (CONFIG_SOUND/CONFIG_SND*=y), so there's nothing
# left for this script to insmod -- it exists purely to create the OSS
# compatibility device nodes below.

# Deliberately does NOT touch the mixer. The driver's power-on defaults are
# already the correct speaker configuration and are verified audible on
# hardware as-is (2026-07-30):
#
#   Jack Function   = Off  -> "no jack plugged in": mutes the HEADPHONE
#                             outputs (MUTE_L/MUTE_R low) and leaves the
#                             speaker path alone. It does NOT mean "muted".
#   Speaker Function = On  -> enables the "Ext Spk" DAPM widget, whose
#                             power event drives the APM_ON GPIO, i.e. the
#                             speaker amplifier.
#   Master Playback  = 121/127 (~0 dB), plenty.
#
# An earlier revision of this script forced Jack Function=Headphone here,
# on the mistaken belief that "Off" was a hard mute. That is backwards --
# it routes audio to the (empty) headphone jack. The real cause of the
# silence it was written to fix was two kernel bugs, since fixed: the
# missing pxa2xx-i2s DMA slave map and the never-set SACR0_BCKD.
# See docs/DEADLETTER-AUDIO-I2S-SILENT.md.

# OSS compatibility nodes (snd-mixer-oss/snd-pcm-oss provide them, but mdev
# does not always create them).
[ -e /dev/mixer ] || mknod /dev/mixer c 14 0
[ -e /dev/dsp ] || mknod /dev/dsp c 14 3

echo "audio stack loaded"
ls -l /dev/dsp /dev/mixer
