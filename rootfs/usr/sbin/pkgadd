#!/bin/sh

OPKG=/usr/bin/opkg
CONF=/etc/opkg/opkg.conf
test -r /etc/piko-media && . /etc/piko-media
CARD_ROOT="${PIKO_CARD_ROOT:-/mnt/card/.zaurus}"
CARD_MNT="${PIKO_CARD_MNT:-/mnt/card}"

SEARCH="$CARD_ROOT/packages $CARD_MNT /tmp /root"

card_mounted() {
    grep -q " $CARD_MNT " /proc/mounts 2>/dev/null
}

list_candidates() {
    n=0
    for d in $SEARCH; do
        [ -d "$d" ] || continue
        for f in "$d"/*.ipk; do
            [ -f "$f" ] || continue
            n=$((n + 1))
            echo "$n $f"
        done
    done
}

if [ ! -x "$OPKG" ]; then
    echo "pkgadd: $OPKG is missing -- opkg is not installed on this device."
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "Installable packages found:"
    echo
    found="$(list_candidates | wc -l)"
    list_candidates | while read num path; do
        echo "  $num  $(basename "$path")"
        echo "         $path"
    done
    if [ "$found" -eq 0 ]; then
        echo "  (none)"
        echo
        echo "Looked in:"
        for d in $SEARCH; do echo "    $d"; done
        echo
        if card_mounted; then
            echo "An SD card IS mounted. Put .ipk files in its .zaurus/packages"
            echo "directory, or just at the top level of the card."
        else
            echo "No SD card is mounted. Insert one, or copy an .ipk to /tmp."
        fi
        exit 0
    fi
    echo
    echo "Install number N with:   pkgadd N"
    echo "Onto the SD card with:   pkgadd N card"
    exit 0
fi

ARG="$1"
DEST_ARG="${2:-root}"

case "$ARG" in
    ''|*[!0-9]*)
        PKGFILE="$ARG"
        ;;
    *)
        PKGFILE="$(list_candidates | while read num path; do
                       [ "$num" = "$ARG" ] && echo "$path"
                   done)"
        if [ -z "$PKGFILE" ]; then
            echo "pkgadd: no package number $ARG. Run pkgadd with no arguments to list."
            exit 1
        fi
        ;;
esac

if [ ! -f "$PKGFILE" ]; then
    echo "pkgadd: no such file: $PKGFILE"
    exit 1
fi

case "$DEST_ARG" in
    root|"")
        DEST_OPTS=""
        DEST_NAME="root"
        WHERE="the root filesystem"
        ;;
    card|sd)
        if ! card_mounted; then
            echo "pkgadd: no card is mounted at $CARD_MNT -- refusing."
            echo
            echo "Nothing was installed. Insert a card and try again, or"
            echo "install to the root instead with:  pkgadd $ARG"
            echo
            echo "(Installing to $CARD_ROOT with no card mounted would write"
            echo " to the root filesystem, not to any card, and the files would"
            echo " be hidden the moment a real card was inserted.)"
            exit 1
        fi
        DEST_OPTS="--add-dest card:$CARD_ROOT -d card"
        DEST_NAME="card"
        WHERE="the card ($CARD_ROOT)"
        ;;
    *)
        echo "pkgadd: unknown destination '$DEST_ARG'. Use 'card' or leave it out."
        exit 1
        ;;
esac

echo "Installing $(basename "$PKGFILE") to $WHERE ..."
echo

OUT="$("$OPKG" --conf "$CONF" $DEST_OPTS install "$PKGFILE" 2>&1)"
RC=$?
echo "$OUT"

if [ "$RC" -eq 0 ]; then
    echo
    echo "Installed to $DEST_NAME."
    exit 0
fi

case "$OUT" in
    *"incompatible architecture"*|*"no valid architecture"*|*"unsupported"*)
        echo
        echo "==> REFUSED: this package is not built for this system."
        echo
        echo "Almost certainly an original Sharp/Zaurus-era .ipk. Those are"
        echo "built for ARM OABI against glibc 2.2.2, usually installing into"
        echo "/home/QtPalmtop for Qtopia. This system is ARM EABI with uClibc"
        echo "and no Qtopia, so the binaries inside cannot be loaded at all --"
        echo "it is a different ABI, not merely an old package."
        echo
        echo "Retro-compatibility is not ready yet, so these are refused"
        echo "rather than half-installed. Nothing was written."
        echo
        echo "Packages built by this project's tools/userspace/make-ipk.sh declare"
        echo "'Architecture: piko' and install normally."
        ;;
esac

exit "$RC"
