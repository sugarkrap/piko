#!/bin/sh
# bright -- one-word backlight control for the Sharp C7x0 panel.
#
# Typable on the device keyboard: no '/' or ':' anywhere in the commands
# you have to enter (same reason wifiup/audioon/netinfo exist).
#
#   bright            show the current level
#   bright up         one step brighter
#   bright down       one step dimmer
#   bright max        full
#   bright min        dimmest still-visible step
#   bright off        blank the backlight (level is remembered)
#   bright on         unblank
#   bright 20         set an explicit 0..47 level
#   bright save       persist the current level to /etc/brightness
#   bright restore    re-apply the persisted level (called from rcS)
#
# ---------------------------------------------------------------------
# NEVER read actual_brightness. It lies.
#
# corgi_bl_set_intensity() in drivers/video/backlight/corgi_lcd.c does
#     if (intensity > 0x10) intensity += 0x10;
# and then stores that ADJUSTED value in lcd->intensity -- which is
# exactly what .get_brightness returns, i.e. what actual_brightness
# reports. Measured on this board 2026-07-31:
#
#     wrote 16 -> brightness 16, actual_brightness 16
#     wrote 17 -> brightness 17, actual_brightness 33
#     wrote 31 -> brightness 31, actual_brightness 47   (== max!)
#     wrote 47 -> brightness 47, actual_brightness 63   (> max!)
#
# At the driver's own default (31) actual_brightness already reads
# exactly max_brightness, so anything trusting it concludes the panel is
# maxed out when it is two thirds up. Read 'brightness' only.
# ---------------------------------------------------------------------
#
# The 16->17 boundary above is not arbitrary: bit 5 of the value written
# to the LCDTG DUTYCTRL register is split off to drive the BL_CONT GPIO,
# so the hardware really has two overlapping ranges (duty 0..16 with
# BL_CONT low, duty 1..31 with it high). The ladder below is spaced to
# straddle that seam rather than pretend the scale is linear.
#
# Device shell notes: this rootfs's BusyBox ash has NO printf, NO working
# 'echo -n', and NO kill/killall/awk. Everything here is plain echo, test
# and case on purpose -- do not "clean it up" with printf.

BL=/sys/class/backlight/corgi_bl
STATE=/etc/brightness

# Non-zero ladder. 0 is deliberately NOT a step: walking 'bright down'
# off the bottom into a black screen on a device with no serial console
# is a bad way to lose the machine. Blanking is an explicit 'bright off',
# which is reversible with 'bright on' without losing the level.
STOPS="2 5 10 16 24 33 47"

if ! test -d "$BL"; then
	echo "bright: no backlight device at $BL"
	echo "bright: is corgi_lcd bound? check dmesg for corgi-lcd/spi1.1"
	exit 1
fi

MAX="$(cat "$BL/max_brightness" 2>/dev/null)"
test -n "$MAX" || MAX=47

cur() {
	cat "$BL/brightness" 2>/dev/null
}

blanked() {
	p="$(cat "$BL/bl_power" 2>/dev/null)"
	test "$p" != "0" -a -n "$p"
}

apply() {
	v="$1"
	if test "$v" -lt 0; then v=0; fi
	if test "$v" -gt "$MAX"; then v="$MAX"; fi
	# Setting a level implies wanting to see it, so always unblank.
	echo 0 > "$BL/bl_power" 2>/dev/null
	echo "$v" > "$BL/brightness" 2>/dev/null || {
		echo "bright: cannot write $BL/brightness (are you root?)"
		exit 1
	}
	echo "brightness $v of $MAX"
}

step_up() {
	c="$(cur)"
	for s in $STOPS; do
		if test "$s" -gt "$c"; then
			apply "$s"
			return
		fi
	done
	apply "$MAX"
}

step_down() {
	c="$(cur)"
	r=""
	for s in $STOPS; do
		if test "$s" -lt "$c"; then
			r="$s"
		fi
	done
	# Already at or below the dimmest step: stay there, do not blank.
	if test -z "$r"; then
		for r in $STOPS; do break; done
	fi
	apply "$r"
}

show() {
	c="$(cur)"
	if blanked; then
		echo "brightness $c of $MAX (blanked -- use: bright on)"
	else
		echo "brightness $c of $MAX"
	fi
}

# The rootfs is jffs2: every save is a flash write. Only write when the
# value actually changed, so holding down Fn+4 does not chew the flash.
save() {
	c="$(cur)"
	old=""
	if test -r "$STATE"; then
		old="$(cat "$STATE" 2>/dev/null)"
	fi
	if test "$c" = "$old"; then
		echo "brightness $c already saved"
		return
	fi
	echo "$c" > "$STATE" 2>/dev/null || {
		echo "bright: cannot write $STATE"
		exit 1
	}
	echo "saved brightness $c"
}

restore() {
	if ! test -r "$STATE"; then
		echo "bright: nothing saved, leaving driver default $(cur)"
		return
	fi
	v="$(cat "$STATE" 2>/dev/null)"
	case "$v" in
	''|*[!0-9]*)
		echo "bright: $STATE is not a number, ignoring"
		return
		;;
	esac
	apply "$v"
}

case "${1:-show}" in
show)		show ;;
up)		step_up ;;
down)		step_down ;;
max)		apply "$MAX" ;;
min)		for s in $STOPS; do apply "$s"; break; done ;;
off)		echo 4 > "$BL/bl_power" 2>/dev/null; echo "backlight off (bright on to restore)" ;;
on)		echo 0 > "$BL/bl_power" 2>/dev/null; show ;;
save)		save ;;
restore)	restore ;;
help|-h|--help)
	echo "bright                show level"
	echo "bright up             brighter"
	echo "bright down           dimmer"
	echo "bright max            full"
	echo "bright min            dimmest"
	echo "bright off            blank"
	echo "bright on             unblank"
	echo "bright 20             set 0..$MAX"
	echo "bright save           remember this level across reboots"
	echo "bright restore        re-apply the remembered level"
	;;
*[!0-9]*)
	echo "bright: unknown command '$1' -- try: bright help"
	exit 1
	;;
*)
	apply "$1"
	;;
esac
